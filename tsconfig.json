{
  "compilerOptions": {
    "baseUrl": ".",
    "outDir": "./dist/",
    "module": "CommonJS",
    "target": "es5",
    "lib": [
      "es6",
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "sourceMap": true,
    "allowJs": true,
    "jsx": "react",
    "moduleResolution": "node",
    "rootDir": "./",
    "forceConsistentCasingInFileNames": true,
    "noImplicitReturns": true,
    "noImplicitThis": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "noUnusedLocals": false,
    "experimentalDecorators": true,
    "useDefineForClassFields": true
  },
  "exclude": [
    "webpack.config.js",
    "node_modules",
    "build",
    "config",
    "tests"
  ]
}
